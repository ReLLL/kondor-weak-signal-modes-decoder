# Upstream decoders are isolated executables; Qt/Fortran never enter the SDR host.
if(DX_ADDITIONAL_MODES)
 enable_language(C)
 enable_language(Fortran)
 set(WSJT_SOURCE "${CMAKE_SOURCE_DIR}/third_party/wsjtx")
 include("${WSJT_SOURCE}/mode-sources.cmake")
 add_library(dx_native_mode_core STATIC ${DX_MODE_FORTRAN} "${WSJT_SOURCE}/lib/crc10.cpp" "${WSJT_SOURCE}/lib/crc13.cpp" "${WSJT_SOURCE}/lib/crc14.cpp")
 target_include_directories(dx_native_mode_core PRIVATE "${WSJT_SOURCE}/lib" "${WSJT_SOURCE}/lib/fst4" ${DSP_INCLUDE_DIRS})
 target_compile_options(dx_native_mode_core PRIVATE $<$<COMPILE_LANGUAGE:Fortran>:-std=legacy;-fallow-argument-mismatch;-fno-second-underscore;-ffree-line-length-none;-frecursive>)
 set_target_properties(dx_native_mode_core PROPERTIES Fortran_MODULE_DIRECTORY "${CMAKE_BINARY_DIR}/native-modules")
 target_include_directories(dx_native_mode_core PUBLIC "${CMAKE_BINARY_DIR}/native-modules")
 set(Q65 "${WSJT_SOURCE}/lib/qra/q65")
 target_sources(dx_native_mode_core PRIVATE "${Q65}/npfwht.c" "${Q65}/pdmath.c" "${Q65}/qracodes.c" "${Q65}/normrnd.c" "${Q65}/qra15_65_64_irr_e23.c" "${Q65}/q65.c" "${Q65}/q65_subs.c")
 target_link_libraries(dx_native_mode_core PUBLIC PkgConfig::DSP)
 add_library(dx_native_mode_adapter STATIC "${CMAKE_SOURCE_DIR}/src/native_modes.f90")
 target_link_libraries(dx_native_mode_adapter PUBLIC dx_native_mode_core)
 target_compile_options(dx_native_mode_adapter PRIVATE -ffree-line-length-none)
 add_executable(dx_modes_decoder "${CMAKE_SOURCE_DIR}/src/mode_helper.cpp")
 target_link_libraries(dx_modes_decoder PRIVATE dx_native_mode_adapter dx_core)
 set(WSPR "${WSJT_SOURCE}/lib/wsprd")
 add_library(dx_wspr_support STATIC "${WSPR}/wsprsim_utils.c" "${WSPR}/wsprd_utils.c" "${WSPR}/tab.c" "${WSPR}/fano.c" "${WSPR}/jelinek.c" "${WSPR}/nhash.c")
 target_include_directories(dx_wspr_support PUBLIC "${WSPR}" ${DSP_INCLUDE_DIRS})
 target_link_libraries(dx_wspr_support PUBLIC m)
 add_library(dx_wspr_entry_core OBJECT "${WSPR}/wsprd.c")
 target_compile_definitions(dx_wspr_entry_core PRIVATE main=dx_wspr_main)
 target_include_directories(dx_wspr_entry_core PRIVATE "${WSPR}" ${DSP_INCLUDE_DIRS})
 add_executable(dx_wspr_decoder "${CMAKE_SOURCE_DIR}/src/wspr_entry.c" "${WSPR}/osdwspr.f90" "${WSJT_SOURCE}/lib/indexx.f90")
 target_link_libraries(dx_wspr_decoder PRIVATE dx_wspr_entry_core dx_wspr_support PkgConfig::DSP)
 set_target_properties(dx_wspr_decoder PROPERTIES LINKER_LANGUAGE CXX)
 add_executable(dx_wspr_simulator "${WSPR}/wsprsim.c")
 target_link_libraries(dx_wspr_simulator PRIVATE dx_wspr_support PkgConfig::DSP)
 add_executable(dx_native_reference "${CMAKE_SOURCE_DIR}/tests/native_reference.cpp" "${CMAKE_SOURCE_DIR}/tests/native_fixture.f90")
 target_link_libraries(dx_native_reference PRIVATE dx_native_mode_adapter dx_core)
 add_test(NAME dx_native_modes COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tests/test_native_modes.py" $<TARGET_FILE:dx_modes_decoder> $<TARGET_FILE:dx_native_reference>)
 add_test(NAME dx_mode_noise COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tests/test_mode_noise.py" $<TARGET_FILE:dx_modes_decoder>)
endif()
if(DX_JS8)
 find_package(Qt6 CONFIG REQUIRED COMPONENTS Core)
 find_package(Eigen3 REQUIRED)
 find_package(Boost REQUIRED)
 execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/scripts/stage_js8.py" --verify COMMAND_ERROR_IS_FATAL ANY)
 set(JS8_SOURCE "${CMAKE_SOURCE_DIR}/third_party/js8call")
 add_library(dx_js8_upstream STATIC "${JS8_SOURCE}/JS8.cpp" "${JS8_SOURCE}/JS8.hpp" "${JS8_SOURCE}/varicode.cpp" "${JS8_SOURCE}/decodedtext.cpp" "${JS8_SOURCE}/jsc.cpp" "${JS8_SOURCE}/jsc_map.cpp" "${JS8_SOURCE}/jsc_list.cpp" "${CMAKE_SOURCE_DIR}/src/js8_globals.cpp")
 set_target_properties(dx_js8_upstream PROPERTIES AUTOMOC ON CXX_STANDARD 20)
 target_include_directories(dx_js8_upstream SYSTEM PUBLIC "${JS8_SOURCE}" ${DSP_INCLUDE_DIRS} ${Boost_INCLUDE_DIRS})
 target_link_libraries(dx_js8_upstream PUBLIC Qt6::Core Eigen3::Eigen PkgConfig::DSP)
 add_library(dx_js8_messages STATIC "${CMAKE_SOURCE_DIR}/src/js8_messages.cpp")
 target_link_libraries(dx_js8_messages PUBLIC dx_js8_upstream dx_core)
 set_target_properties(dx_js8_messages PROPERTIES CXX_STANDARD 20)
 add_executable(dx_js8_decoder "${CMAKE_SOURCE_DIR}/src/js8_helper.cpp")
 target_link_libraries(dx_js8_decoder PRIVATE dx_js8_messages)
 set_target_properties(dx_js8_decoder PROPERTIES CXX_STANDARD 20)
 add_executable(dx_js8_reference "${CMAKE_SOURCE_DIR}/tests/js8_reference.cpp")
 target_link_libraries(dx_js8_reference PRIVATE dx_js8_messages)
 set_target_properties(dx_js8_reference PROPERTIES CXX_STANDARD 20)
 add_test(NAME dx_js8_decoder COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tests/test_js8_decoder.py" $<TARGET_FILE:dx_js8_decoder> $<TARGET_FILE:dx_js8_reference>)
 set_tests_properties(dx_js8_decoder PROPERTIES TIMEOUT 180)
endif()
